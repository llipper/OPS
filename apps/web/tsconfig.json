{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@workspace/auth": ["../../packages/auth/src/index.ts"],
      "@workspace/database": ["../../packages/database/src/index.ts"],
      "@workspace/permissions": ["../../packages/permissions/src/index.ts"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "scratch", "scratch/**/*.ts"]
}
