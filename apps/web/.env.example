# ============================================================
# VARIÁVEIS DE AMBIENTE - TEMPLATE (apps/web)
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o arquivo .env com valores reais!
# ============================================================

# ============================================================
# BANCO DE DADOS — Escolha uma das opções abaixo
# ============================================================

# -----------------------------------------------------------
# OPÇÃO 1: PostgreSQL Local (Docker ou instalação local)
# -----------------------------------------------------------
# DATABASE_URL="postgresql://postgres:root@localhost:5432/ops?schema=public"

# -----------------------------------------------------------
# OPÇÃO 2: Supabase
# Encontre em: Supabase Dashboard → Settings → Database → Connection string → URI
# -----------------------------------------------------------
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# -----------------------------------------------------------
# OPÇÃO 3: Supabase com Pooler (produção com alta concorrência)
# Encontre em: Supabase Dashboard → Settings → Database → Connection pooling
# Requer também descomentar directUrl no packages/database/prisma/schema.prisma
# -----------------------------------------------------------
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ✅ Descomente APENAS uma das opções acima e preencha com seus dados:
DATABASE_URL=""
DIRECT_URL=""  # apenas se usar OPÇÃO 3 (pooler)

# URL pública da aplicação
# Local:
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Produção:
NEXT_PUBLIC_APP_URL="https://ops-web-beta.vercel.app"

# Autenticação (Auth.js / NextAuth)
# Gere um secret seguro com: openssl rand -base64 32
AUTH_SECRET=""
# Local:
# AUTH_URL="http://localhost:3000/api/auth"
# Produção:
AUTH_URL="https://ops-web-beta.vercel.app/api/auth"
AUTH_TRUST_HOST="true"

# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID="eleven_flash_v2_5"
