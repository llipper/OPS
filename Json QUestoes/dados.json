SELECT 
  -- Nível 1: Disciplina
  d.id AS disciplina_id,
  d.nome AS disciplina_nome,
  d.sigla AS disciplina_sigla,
  
  -- Nível 2: Assunto
  a.id AS assunto_id,
  a.nome AS assunto_nome,
  
  -- Nível 3: Tópico
  t.id AS topico_id,
  t.nome AS topico_nome,
  
  -- Nível 4: Subtópico
  s.id AS subtopico_id,
  s.nome AS subtopico_nome

FROM disciplinas d

-- 1. Busca os Assuntos da Disciplina
LEFT JOIN assuntos a ON a."disciplinaId" = d.id

-- 2. Busca os Tópicos de cada Assunto
LEFT JOIN topicos t ON t."assuntoId" = a.id

-- 3. Busca os Subtópicos de cada Tópico
LEFT JOIN subtopicos s ON s."topicoId" = t.id

ORDER BY 
  disciplina_nome, 
  a.ordem, 
  assunto_nome, 
  t.ordem, 
  topico_nome, 
  s.ordem, 
  subtopico_nome;


