SELECT 
  -- Nível 1: Carreira Principal
  c1.id AS carreira_principal_id,
  c1.nome AS carreira_principal_nome,
  
  -- Nível 2: Subcarreira
  c2.id AS subcarreira_id,
  c2.nome AS subcarreira_nome,
  
  -- Nível 3: Órgão / Instituição
  c3.id AS orgao_id,
  c3.nome AS orgao_nome,
  
  -- Nível 4: Concurso associado
  con.id AS concurso_id,
  con.nome AS concurso_nome,
  con.ano AS concurso_ano,
  
  -- Nível 5: Cargo associado
  car.id AS cargo_id,
  car.nome AS cargo_nome

FROM carreiras c1

-- 1. Busca as Subcarreiras
LEFT JOIN carreiras c2 ON c2."parentId" = c1.id

-- 2. Busca os Órgãos/Instituições
LEFT JOIN carreiras c3 ON c3."parentId" = c2.id

-- 3. Associa com Concursos (podem estar vinculados ao órgão, subcarreira ou carreira)
LEFT JOIN concursos con ON con."carreiraId" = c3.id 
                        OR con."carreiraId" = c2.id 
                        OR con."carreiraId" = c1.id

-- 4. Associa os Cargos de cada Concurso
LEFT JOIN cargos car ON car."concursoId" = con.id

-- Filtra apenas pelo topo (Carreiras que não são subcarreiras de ninguém)
WHERE c1."parentId" IS NULL

ORDER BY 
  carreira_principal_nome, 
  subcarreira_nome, 
  orgao_nome, 
  concurso_nome, 
  cargo_nome;



