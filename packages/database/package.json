{
  "name": "@workspace/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "seed:pm-ce-soldado-dev": "tsx prisma/seed-pm-ce-soldado-dev.ts",
    "seed:taxonomy": "tsx prisma/seed-taxonomy.ts",
    "seed:bancas": "tsx prisma/seed-bancas.ts",
    "seed:users": "dotenv -e ../../.env -- tsx prisma/seed-users.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.22.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
